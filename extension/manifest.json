{
  "manifest_version": 3,
  "name": "Self-Hosted Browser VPN",
  "version": "0.2.1",
  "description": "Настройте HTTP, HTTPS или SOCKS5-прокси для Chrome. Проверяйте внешний IP и добавляйте исключения для сайтов.",
  "minimum_chrome_version": "108",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Self-Hosted Browser VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
