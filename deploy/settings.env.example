# Copy to settings.env and edit the values before starting Compose.
# Use domain with a DNS A record, or ip with a public IPv4 address.
SHBVPN_KIND=domain
SHBVPN_HOST=proxy.example.com
SHBVPN_PORT=443
SHBVPN_EMAIL=
# Comma-separated extra public ingress addresses behind NAT or floating IPs.
SHBVPN_SELF_ADDRESSES=
# Set to 1 only when intentionally removing all saved extra addresses.
SHBVPN_CLEAR_SELF_ADDRESSES=0
