FROM golang:1.26-alpine AS build

WORKDIR /src/server
COPY server/go.mod ./
COPY server/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/shbvpn-proxy .

FROM python:3.12-alpine

RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 10001 shbvpn && \
    adduser -S -D -H -u 10001 -G shbvpn shbvpn
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=build /out/shbvpn-proxy /app/shbvpn-proxy
COPY deploy/run_server.py /app/run_server.py
COPY installer/healthcheck.py /app/healthcheck.py
USER 10001:10001
ENTRYPOINT ["python3", "/app/run_server.py"]
